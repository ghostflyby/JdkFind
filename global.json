{
  // Same convention as dotnet-pty: pin the SDK floor so local builds and CI share
  // one toolchain; Major accepts any installed SDK at or above this floor.
  "sdk": {
    "version": "10.0.404",
    "rollForward": "Major",
    "allowPrerelease": false
  },
  // Puts dotnet test into its .NET 10 MTP mode, which is how the xunit.v3 test
  // project runs (the legacy VSTest mode on the .NET 10 SDK refuses MTP projects).
  "test": {
    "runner": "Microsoft.Testing.Platform"
  }
}
