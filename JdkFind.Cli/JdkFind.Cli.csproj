<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>JdkFind.Cli</RootNamespace>
        <!-- Shortest executable name, no dll name collisions. -->
        <AssemblyName>jdkfind</AssemblyName>
        <IsAotCompatible>true</IsAotCompatible>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>jdkfind</ToolCommandName>
        <PackageId>JdkFind.Cli</PackageId>
        <Version>0.1.1</Version>
        <Authors>ghostflyby</Authors>
        <Description>Locate installed JDKs across Windows, macOS and Linux.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/ghostflyby/JdkFind</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JdkFind\JdkFind.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="JdkFind.Tests" />
    </ItemGroup>

</Project>
