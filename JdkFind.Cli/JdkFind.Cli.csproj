<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>JdkFind.Cli</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>jdkfind</ToolCommandName>
        <PackageId>JdkFind.Cli</PackageId>
        <Version>0.1.0</Version>
        <Description>Locate installed JDKs across Windows, macOS and Linux.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JdkFind\JdkFind.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="JdkFind.Tests" />
    </ItemGroup>

</Project>
