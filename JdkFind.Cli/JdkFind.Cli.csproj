<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The execvp LibraryImport generates an unsafe marshalling stub. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>JdkFind.Cli</RootNamespace>
    <!-- Shortest executable name, no dll name collisions. -->
    <AssemblyName>jdkfind</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- No culture-sensitive surface: version input is integer segments and
         output echoes release-file strings, so drop the ICU link and dlopen. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jdkfind</ToolCommandName>
    <PackageId>JdkFind.Cli</PackageId>
    <Authors>ghostflyby</Authors>
    <Description>Locate installed JDKs across Windows, macOS and Linux.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ghostflyby/JdkFind</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ghostflyby/JdkFind</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JdkFind\JdkFind.csproj"/>
  </ItemGroup>

  <!-- Completion scripts embedded as manifest resources and served by the
       `completions` command. JdkFindCompletionsExclude lists shells to leave
       out of the embedding — canonical shell names (bash, zsh, fish,
       powershell), semicolon-separated, case-insensitive — for packaging
       channels that install completion files themselves and prefer the
       command not to offer them; the runtime then reports the shell as not
       available in this build. -->
  <ItemGroup>
    <EmbeddedResource Include="completions/jdkfind.bash" LogicalName="jdkfind.completions.bash"
                      Condition="!$([System.String]::Copy('$(JdkFindCompletionsExclude)').ToLower().Contains('bash'))"/>
    <EmbeddedResource Include="completions/jdkfind.zsh" LogicalName="jdkfind.completions.zsh"
                      Condition="!$([System.String]::Copy('$(JdkFindCompletionsExclude)').ToLower().Contains('zsh'))"/>
    <EmbeddedResource Include="completions/jdkfind.fish" LogicalName="jdkfind.completions.fish"
                      Condition="!$([System.String]::Copy('$(JdkFindCompletionsExclude)').ToLower().Contains('fish'))"/>
    <EmbeddedResource Include="completions/jdkfind.ps1" LogicalName="jdkfind.completions.powershell"
                      Condition="!$([System.String]::Copy('$(JdkFindCompletionsExclude)').ToLower().Contains('powershell'))"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JdkFind.Tests"/>
  </ItemGroup>

  <!-- jdkfind uses no TLS or compression at runtime. Some NativeAOT runtime
       pack variants (e.g. the SDK-bundled one in Homebrew's dotnet) lack the
       static libz/libbrotli archives and carry nonportable.txt, which makes
       Microsoft.NETCore.Native.Unix.targets pass -lssl -lcrypto -lz
       -lbrotli{enc,dec,common} to the linker. Nothing references symbols from
       those libraries after dead-stripping, so drop the load commands. Remove
       on absent items is a no-op on toolchains that never add them. -->
  <Target Name="RemoveUnusedNativeLibraries"
          Condition="'$(PublishAot)' == 'true'"
          BeforeTargets="LinkNative">
    <ItemGroup>
      <LinkerArg Remove="-lssl" />
      <LinkerArg Remove="-lcrypto" />
      <LinkerArg Remove="-lz" />
      <LinkerArg Remove="-lbrotlienc" />
      <LinkerArg Remove="-lbrotlidec" />
      <LinkerArg Remove="-lbrotlicommon" />
    </ItemGroup>
  </Target>

</Project>
