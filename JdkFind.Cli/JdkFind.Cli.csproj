<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The execvp LibraryImport generates an unsafe marshalling stub. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>JdkFind.Cli</RootNamespace>
    <!-- Shortest executable name, no dll name collisions. -->
    <AssemblyName>jdkfind</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jdkfind</ToolCommandName>
    <PackageId>JdkFind.Cli</PackageId>
    <Version>0.5.1</Version>
    <Authors>ghostflyby</Authors>
    <Description>Locate installed JDKs across Windows, macOS and Linux.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ghostflyby/JdkFind</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JdkFind\JdkFind.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JdkFind.Tests"/>
  </ItemGroup>

  <!-- NativeAOT links the runtime pack's zlib/brotli/zstd libraries even when
       System.IO.Compression is unused. The CLI never compresses anything, so
       drop them from the link: the static pack archives (libz.a, libbrotli*.a),
       the Windows zlibstatic variant, or any -l system fallback a pack without
       statics would add. -->
  <Target Name="RemoveNativeLibraries"
          AfterTargets="SetupOSSpecificProps">

    <ItemGroup>
      <LinkerArg Remove="@(LinkerArg)"
        Condition="$([System.String]::Copy('%(LinkerArg.Identity)').Contains('brotli'))" />

      <LinkerArg Remove="@(LinkerArg)"
        Condition="$([System.String]::Copy('%(LinkerArg.Identity)').Contains('zstd'))" />

      <LinkerArg Remove="@(LinkerArg)"
        Condition="$([System.String]::Copy('%(LinkerArg.Identity)').Contains('libz.a'))" />

      <LinkerArg Remove="@(LinkerArg)"
        Condition="$([System.String]::Copy('%(LinkerArg.Identity)').Contains('zlibstatic'))" />
    </ItemGroup>

  </Target>

</Project>
